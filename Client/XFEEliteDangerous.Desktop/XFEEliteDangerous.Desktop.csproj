<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <ActiveDebugProfile>XFEEliteDangerous.Desktop (Unpackaged)</ActiveDebugProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="XFEExtension.NetCore.WinUIHelper" Version="2.0.1" />
    <PackageReference Include="XFEExtension.NetCore.AutoConfig" Version="4.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <Compile Include="../../Desktop/SharedUI/*.cs" Link="Desktop/%(Filename)%(Extension)" />
    <Page Include="../../Desktop/SharedUI/NavigationHostPage.xaml" Link="Desktop/NavigationHostPage.xaml" />
    <ProjectReference Include="../XFEEliteDangerous.Client/XFEEliteDangerous.Client.csproj" />
    <ProjectReference Include="../../Local/XFEEliteDangerous.Core/XFEEliteDangerous.Core.csproj" />
    <ProjectReference Include="../XFEEliteDangerous.ManagementClient/XFEEliteDangerous.ManagementClient.csproj" />
    <ProjectReference Include="../XFEEliteDangerous.OnlineClient/XFEEliteDangerous.OnlineClient.csproj" />
  </ItemGroup>
  <Target Name="PublishUnpackagedWinUIResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application PRI was not generated." />
    <Error Condition="!Exists('$(TargetDir)Desktop/NavigationHostPage.xbf')" Text="Compiled WinUI navigation host XBF was not generated." />
    <Error Condition="!Exists('$(TargetDir)App.xbf') or !Exists('$(TargetDir)MainWindow.xbf')" Text="Required WinUI application/window XBF resources were not generated." />
    <ItemGroup>
      <_WinUIResources Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUIResources)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
